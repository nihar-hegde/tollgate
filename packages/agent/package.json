{
  "name": "@tollgate/agent",
  "version": "0.0.0",
  "private": true,
  "description": "Buyer agent: CLI and MCP server exposing pay_and_fetch.",
  "type": "module",
  "scripts": {
    "start": "tsx --env-file-if-exists=../../.env src/cli.ts",
    "test-transfer": "tsx --env-file-if-exists=../../.env scripts/test-transfer.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "buy": "tsx --env-file-if-exists=../../.env src/cli.ts buy",
    "resume": "tsx --env-file-if-exists=../../.env src/cli.ts resume",
    "mcp": "tsx --env-file-if-exists=../../.env src/mcp-stdio.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "catalog:",
    "@tollgate/shared": "workspace:*",
    "@x402/core": "catalog:",
    "@x402/evm": "catalog:",
    "@x402/fetch": "catalog:",
    "viem": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@tollgate/authorizer": "workspace:*",
    "@tollgate/db": "workspace:*",
    "@tollgate/seller": "workspace:*",
    "@types/node": "catalog:",
    "drizzle-orm": "catalog:",
    "jose": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
