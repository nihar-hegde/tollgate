# Copy to .env and fill in. TESTNET ONLY. Never commit .env.

# Base Sepolia
CHAIN_ID=84532
RPC_URL=https://sepolia.base.org
USDC_ADDRESS=0x036CbD53842c5426634e7929541eC2318f3dCF7e

# Wallets (testnet-only keys)
AGENT_PRIVATE_KEY=
SELLER_ADDRESS=

# x402
X402_FACILITATOR_URL=https://x402.org/facilitator

# Database
DATABASE_URL=postgres://tollgate:tollgate@localhost:5432/tollgate
# Server for the tests. Each package recreates its own tollgate_<package>_test database on every run.
TEST_POSTGRES_URL=postgres://tollgate:tollgate@localhost:5432

# Authorizer
AUTHORIZER_URL=http://localhost:4000
AUTHORIZER_MODE=enforce
# AUTHORIZER_SIGNING_KEY, AUTHORIZER_AGENT_KEY and AUTHORIZER_SECRET_KEY are generated into .env by:
#   pnpm --filter @tollgate/authorizer keygen

# Seller
SELLER_PORT=4001
ACCEPTED_KID_PREFIXES=local-
OPERATOR_MANDATES=
