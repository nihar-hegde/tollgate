# Copy to .env and fill in. TESTNET ONLY. Never commit .env.

# Base Sepolia
CHAIN_ID=84532
RPC_URL=https://sepolia.base.org
USDC_ADDRESS=0x036CbD53842c5426634e7929541eC2318f3dCF7e

# Wallets (testnet-only keys)
AGENT_PRIVATE_KEY=
SELLER_ADDRESS=
# Which agent the buyer asks for (the seeded demo agent).
AGENT_ID=agt_research_01

# x402
X402_FACILITATOR_URL=https://x402.org/facilitator

# Database
# Any Postgres: Neon's pooled URL (with sslmode=verify-full), or the Docker one from `pnpm db:up`.
DATABASE_URL=postgres://tollgate:tollgate@localhost:5432/tollgate
# Server for the tests. Each package recreates its own tollgate_<package>_test database on every run.
TEST_POSTGRES_URL=postgres://tollgate:tollgate@localhost:5432

# Authorizer
AUTHORIZER_URL=http://localhost:4000
AUTHORIZER_MODE=enforce
# AUTHORIZER_SIGNING_KEY, AUTHORIZER_AGENT_KEY and AUTHORIZER_SECRET_KEY are generated into .env by:
#   pnpm --filter @tollgate/authorizer keygen

# Seller
SELLER_URL=http://localhost:4001
# Which verdict keys this seller trusts: local- for Tollgate's authorizer.
ACCEPTED_KID_PREFIXES=local-
# The mandate ids your operator registered with this seller, comma-separated.
# The authorizer's seed script prints the demo one.
OPERATOR_MANDATES=
# Point these at Saifuro to verify their verdicts instead (defaults: the local authorizer).
# VERDICT_ISSUER=https://verdicts.saifuro.com
# VERDICT_JWKS_URL=https://verdicts.saifuro.com/.well-known/jwks.json

# Indexer
INDEXER_URL=http://localhost:4002
# First run only (after that the cursor decides); just before Tollgate's first paid call.
INDEXER_START_BLOCK=50980900
