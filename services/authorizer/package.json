{
  "name": "@tollgate/authorizer",
  "version": "0.0.0",
  "private": true,
  "description": "Local authorizer: mandates, gate evaluation, ES256 verdicts, JWKS, append-only decision log.",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/index.ts",
    "start": "tsx --env-file-if-exists=../../.env src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "keygen": "tsx scripts/keygen.ts",
    "seed": "tsx --env-file-if-exists=../../.env scripts/seed.ts"
  },
  "dependencies": {
    "@tollgate/db": "workspace:*",
    "@tollgate/shared": "workspace:*",
    "drizzle-orm": "catalog:",
    "express": "catalog:",
    "jose": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/express": "catalog:",
    "@types/node": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
